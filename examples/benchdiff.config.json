{
  "$schema": "https://raw.githubusercontent.com/tstapler/benchdiff/v0/benchdiff.config.schema.json",
  "version": 1,
  "threshold": 5,
  "thresholds": { "allocs/op": 0 },
  "min-abs": 0,
  "sort": "delta",
  "max-rows": 50,
  "only-changed": true,
  "fail-on-regression": 10,
  "title": "Benchmark comparison",
  "format": "auto",
  "charts": "delta,ranking",
  "chart-rows": 30,
  "chart-width": 760,
  "chart-theme": "both",
  "svg-embed": "auto",
  "compare-by": "impl",
  "group-by": ["size"],
  "dimensions": ["impl=^Benchmark(?P<impl>Fast|Slow)", "size=n=(?P<size>\\d+)"],
  "dimensions-strict": false,
  "reference": "base",
  "correction": "holm",
  "cell-format": "full"
}
